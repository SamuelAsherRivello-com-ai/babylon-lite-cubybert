{
  "name": "qbert-clone",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck:config && vite build && node --experimental-strip-types scripts/check-deployment-assets.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test qbert-clone/test/game.test.mjs",
    "test:browser": "node qbert-clone/test/browser.mjs",
    "typecheck:config": "tsc -p tsconfig.config.json"
  },
  "dependencies": {
    "@babylonjs/lite": "1.32.0"
  },
  "devDependencies": {
    "vite": "8.3.1",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "@types/node": "24.19.2"
  }
}
